diff --git a/lib/rigger.js b/lib/rigger.js
index c325e02..aae4fff 100644
--- a/lib/rigger.js
+++ b/lib/rigger.js
@@ -517,6 +517,134 @@
     };
   }
 
+  // ---------- painter's order sanity ----------
+  // see-through (and hand-made PSDs) sometimes emit face parts in an order that
+  // hides them: eyewhite above irides, eyebrow / mouth below the face, eyelash
+  // under the eyewhite. A face part is never meant to sit under the face, and
+  // the eye stack is always eyewhite < irides < eyelash. Parts with the same
+  // rank keep their original order (eyebrow vs eyelash is the artist's call).
+  var FACE_RANK = { 'facedetail': 1, 'nose': 1, 'mouth_open': 1, 'mouth_close': 1, 'mouth_gen': 1,
+                    'eyewhite': 2, 'irides': 3, 'eyelash': 4, 'eye_close': 4, 'eye_close2': 4,
+                    'eyebrow': 4, 'eyewear': 5 };
+  var BELOW_FACE = { 'back hair': 1, 'neck': 1 };
+  var ABOVE_FACE = { 'front hair': 1, 'side hair': 1, 'ahoge': 1 };
+  function partBaseName(p) { return baseName(p.name.replace(/_(l|r)$/, '')); }
+  function overlapPx(a, b) {   // visible pixels the two parts share
+    var x0 = Math.max(a.x, b.x), y0 = Math.max(a.y, b.y), x1 = Math.min(a.x + a.w, b.x + b.w), y1 = Math.min(a.y + a.h, b.y + b.h);
+    if (x1 <= x0 || y1 <= y0) return 0;
+    var n = 0, ad = a.img.data, bd = b.img.data;
+    for (var y = y0; y < y1; y++) for (var x = x0; x < x1; x++)
+      if (ad[((y - a.y) * a.w + (x - a.x)) * 4 + 3] > 32 && bd[((y - b.y) * b.w + (x - b.x)) * 4 + 3] > 32) n++;
+    return n;
+  }
+  // must a be drawn under b?
+  function mustBeUnder(a, b) {
+    var A = partBaseName(a), B = partBaseName(b);
+    if (A === 'face') return FACE_RANK[B] != null || !!ABOVE_FACE[B];
+    if (B === 'face') return !!BELOW_FACE[A];
+    var ra = FACE_RANK[A], rb = FACE_RANK[B];
+    return ra != null && rb != null && ra < rb && !(A === 'eyebrow' || B === 'eyebrow');
+  }
+  // Fix only pairs that are in the wrong order AND actually overlap, with the
+  // smallest move; every other layer keeps the artist's order.
+  function normalizeFaceOrder(parts) {
+    var moved = [], guard = parts.length * parts.length, cache = Object.create(null);
+    function ov(a, b) { var k = a.name + '|' + b.name; if (cache[k] == null) cache[k] = overlapPx(a, b) > 12; return cache[k]; }
+    function note(p) { var b = partBaseName(p); if (moved.indexOf(b) < 0) moved.push(b); }
+    var changed = true;
+    while (changed && guard-- > 0) {
+      changed = false;
+      outer:
+      for (var i = 0; i < parts.length; i++) for (var j = i + 1; j < parts.length; j++) {
+        var a = parts[i], b = parts[j];          // a is drawn under b now
+        if (!mustBeUnder(b, a) || !ov(a, b)) continue;
+        if (ABOVE_FACE[partBaseName(a)]) {       // bangs under the face: lift them above the whole face stack
+          var last = j;
+          for (var k = j; k < parts.length; k++) if (partBaseName(parts[k]) === 'face' || FACE_RANK[partBaseName(parts[k])] != null) last = k;
+          parts.splice(i, 1); parts.splice(last, 0, a); note(a);
+        } else if (partBaseName(b) === 'face') { // a face part under the face: lift it right above the face
+          parts.splice(i, 1); parts.splice(j, 0, a); note(a);
+        } else {                                 // otherwise drop the upper one just below the other
+          parts.splice(j, 1); parts.splice(i, 0, b); note(b);
+        }
+        changed = true; break outer;
+      }
+    }
+    return moved;
+  }
+
+  // see-through sometimes puts (part of) the eyebrow into the eyelash layer;
+  // those pixels would vanish on every blink. Pieces of the lash layer that sit
+  // clearly above the eyewhite are moved to an eyebrow part of their own.
+  function splitBrowFromLash(parts, anchors, hasWhite) {
+    var out = [];
+    for (var i = 0; i < parts.length; i++) {
+      var p = parts[i];
+      if (partBaseName(p) !== 'eyelash' || !p.side || p.synthetic || !hasWhite[p.side]) continue;
+      var EA = anchors['eye' + p.side]; if (!EA) continue;
+      var eh = Math.max(4, EA.y1 - EA.y0), w = p.w, h = p.h, d = p.img.data, k, l;
+      var yCut = EA.y0 - 0.05 * eh - p.y;   // local rows above the eyewhite
+      // lash ink = the dark end of the layer; brow pieces are lighter and sit above the eye
+      var lum = new Float32Array(w * h), vals = [];
+      for (k = 0; k < w * h; k++) if (d[k * 4 + 3] > 32) { lum[k] = (0.299 * d[k * 4] + 0.587 * d[k * 4 + 1] + 0.114 * d[k * 4 + 2]) / 255; vals.push(lum[k]); }
+      if (vals.length < 30) continue;
+      vals.sort(function (u, v) { return u - v; });
+      var ink = vals[Math.floor(vals.length * 0.2)];
+      var whole = new Uint8Array(w * h), cand = new Uint8Array(w * h);
+      for (k = 0; k < w * h; k++) {
+        if (d[k * 4 + 3] <= 32) continue;
+        whole[k] = 255;
+        if (((k / w) | 0) < yCut && lum[k] > ink + 0.28) cand[k] = 255;
+      }
+      var pick = new Uint8Array(w * h), any = false;
+      // (a) whole pieces of the layer that float above the eye
+      var cw = labelComponents(whole, w, h, 0), stat = function (cc) {
+        var n = cc.count, maxY = new Int32Array(n + 1).fill(-1), sumY = new Float64Array(n + 1);
+        for (var q = 0; q < w * h; q++) { var lb = cc.lab[q]; if (!lb) continue; var yy = (q / w) | 0; sumY[lb] += yy; if (yy > maxY[lb]) maxY[lb] = yy; }
+        return { maxY: maxY, sumY: sumY };
+      };
+      var sw = stat(cw);
+      for (l = 1; l <= cw.count; l++) if (cw.sizes[l] >= 15 && sw.maxY[l] < yCut - 0.01 * eh && sw.sumY[l] / cw.sizes[l] < yCut - 0.2 * eh) { any = true; for (k = 0; k < w * h; k++) if (cw.lab[k] === l) pick[k] = 1; }
+      // (b) light blobs fused onto the top of the lash line
+      var cl = labelComponents(cand, w, h, 0), minSize = Math.max(15, vals.length * 0.06);
+      var sc = stat(cl);
+      for (l = 1; l <= cl.count; l++) {
+        if (cl.sizes[l] < minSize || sc.maxY[l] - sc.sumY[l] / cl.sizes[l] < 1.5) continue;
+        // a brow is a thick blob; thin lines here are lid creases, which belong to the open eye
+        var cx0 = 1e9, cx1 = -1;
+        for (k = 0; k < w * h; k++) if (cl.lab[k] === l) { var ccx = k % w; if (ccx < cx0) cx0 = ccx; if (ccx > cx1) cx1 = ccx; }
+        if (cl.sizes[l] / (cx1 - cx0 + 1) < 0.18 * eh) continue;
+        any = true; for (k = 0; k < w * h; k++) if (cl.lab[k] === l) pick[k] = 1;
+      }
+      if (!any) continue;
+      for (var it = 0; it < 2; it++) {   // take the blob's own outline (mid tones), not the lash ink
+        var grow = pick.slice();
+        for (k = 0; k < w * h; k++) {
+          if (pick[k] || d[k * 4 + 3] <= 32 || ((k / w) | 0) >= yCut || lum[k] <= ink + 0.1) continue;
+          var xk = k % w;
+          if ((xk > 0 && pick[k - 1]) || (xk < w - 1 && pick[k + 1]) || (k >= w && pick[k - w]) || (k + w < w * h && pick[k + w])) grow[k] = 1;
+        }
+        pick = grow;
+      }
+      var nd = new Uint8ClampedArray(d.length);
+      for (var y2 = 0; y2 < h; y2++) for (var x2 = 0; x2 < w; x2++) {
+        var q = y2 * w + x2; if (!d[q * 4 + 3]) continue;
+        var take = pick[q];
+        if (!take && d[q * 4 + 3] <= 32 && y2 < yCut)   // antialiased fringe next to a moved piece
+          for (var dy = -1; dy <= 1 && !take; dy++) for (var dx = -1; dx <= 1; dx++) {
+            var yy = y2 + dy, xx = x2 + dx; if (yy >= 0 && xx >= 0 && yy < h && xx < w && pick[yy * w + xx]) { take = 1; break; }
+          }
+        if (take) { nd[q * 4] = d[q * 4]; nd[q * 4 + 1] = d[q * 4 + 1]; nd[q * 4 + 2] = d[q * 4 + 2]; nd[q * 4 + 3] = d[q * 4 + 3]; d[q * 4 + 3] = 0; }
+      }
+      var slot = SLOTS['eyebrow'];
+      out.push({ after: p, part: { name: 'eyebrow_9_' + p.side.toLowerCase(), source: p.source, x: p.x, y: p.y, w: w, h: h, z: 0,
+        depth: slot.depth, group: slot.group, phys: null, opacity: p.opacity, fade: null, side: p.side, strands: null,
+        fromLash: true, img: { width: w, height: h, data: nd } } });
+    }
+    out.forEach(function (o) { parts.splice(parts.indexOf(o.after) + 1, 0, o.part); });
+    return out.length;
+  }
+
   // ---------- main ----------
   function buildRig(psd, opts) {
     opts = opts || {};
@@ -615,11 +743,20 @@
       }
     }
 
+    var reordered = normalizeFaceOrder(parts);
+    if (reordered.length) warnings.push('顔パーツの重なり順を自動補正しました（' + reordered.map(function (b) { return ROLE_LABELS[b] || b; }).join('、') + '）');
+
     // anchors
-    var anchors = { face: FACE };
+    var anchors = { face: FACE }, eyeGuessed = false;
     ['l', 'r'].forEach(function (s) {
       var ew = sided['eyewhite|' + s], ir = sided['irides|' + s], ec = sided['eye_close|' + s];
       var K = 'eye' + s.toUpperCase();
+      if (!ew) {
+        // no eyewhite (see-through sometimes drops it): the eye is where the
+        // irides and the lashes are
+        var src = [ir, sided['eyelash|' + s]].filter(Boolean);
+        if (src.length) { ew = mergeAlphas(src.map(function (a) { return { alpha: a }; }), W, H); eyeGuessed = true; }
+      }
       if (ew) {
         var b = bboxOf(ew, W, H, 8);
         var a = { x0: b.x0, x1: b.x1, y0: b.y0, y1: b.y1 };
@@ -631,6 +768,9 @@
       }
     });
     if (!anchors.eyeL || !anchors.eyeR) warnings.push('目のアンカーが不完全です（eyewhite/irides を確認）');
+    else if (eyeGuessed) warnings.push('白目レイヤーが無いため、瞳とまつ毛から目の位置を推定しました');
+    if (splitBrowFromLash(parts, anchors, { L: !!sided['eyewhite|l'], R: !!sided['eyewhite|r'] }))
+      warnings.push('まつ毛レイヤーに混ざっていた眉を分離しました（まばたきで消えないように）');
 
     var mouthAlpha = merged('mouth_open') || merged('mouth_close');
     if (mouthAlpha) {
@@ -741,5 +881,6 @@
            SLOT_NAMES: Object.keys(SLOTS),
            _internals: { findPeaks: findPeaks, detectStrands: detectStrands,
                          labelComponents: labelComponents, cleanAlpha: cleanAlpha,
-                         imageLayersOf: imageLayersOf, mergeAlphas: mergeAlphas, resampleRGBA: resampleRGBA } };
+                         imageLayersOf: imageLayersOf, mergeAlphas: mergeAlphas, resampleRGBA: resampleRGBA,
+                         normalizeFaceOrder: normalizeFaceOrder } };
 });
