+// ---------- procedural mouth (lib/mouthgen.js) ----------
+// See-through PSDs have one drawn `mouth` and no open/close diffs. Instead of
+// stretching that drawing and cross-fading to a generic closed mouth, measure
+// it once and draw the mouth for every frame from continuous parameters.
+const MG=window.MouthGen;
+let mg=null;                                   // {st, L, img, key, P, genA, origA}
+const VOWEL_KEYS=['a','i','u','e','o'];
+let vowelCur={a:1,i:0,u:0,e:0,o:0},micVowel=null,micVowelAt=0,remoteVowel=null,remoteVowelAt=0,talkVowel='a';
+function setupMouthGen(rig){if(MG)MG.attachToRig(rig,Rigger.baseName);}
+function mgOn(e){return !!mg&&e.mouthGen>=0.5;}
+function mouthParams(e){return MG.mix(e.vw||vowelCur,e.mouthOpen,e.mouthForm);}
+// Called once per rendered frame before deform(): updates the texture only when the shape changed.
+function updateMouthGen(e){
+  if(!mgOn(e))return;
+  const P=mouthParams(e);mg.P=P;
+  const st=mg.st;
+  if(st.origOpen){mg.genA=1;mg.origA=0;}
+  else{   // the drawing is a closed mouth: show it untouched while the mouth is closed
+    const k=smooth(Math.max(P.o/0.05,Math.abs(P.s-1)/0.05,Math.abs(P.f)/0.15));
+    mg.genA=k;mg.origA=1-k;
+  }
+  const key=[P.o,P.s,P.r,P.f,P.tt].map(v=>Math.round(v*250)).join(',');
+  if(key!==mg.key&&mg.genA>0.004){mg.key=key;MG.render(st,P,mg.img);renderer.updateTexture(mg.L,mg.img);}
+}
+// Vowel weights for this frame: microphone / audio file → OBS relay → talk → sliders → あ.
+function targetVowels(e){
+  const now=performance.now();
+  if(micVowel&&auto.mic&&mic.active&&now-micVowelAt<350)return micVowel;
+  if(OBS_MODE&&remoteVowel&&now-remoteVowelAt<500)return remoteVowel;
+  if(auto.talk&&talkOn&&!auto.mic)return {[talkVowel]:1};
+  const m={a:e.vowelA,i:e.vowelI,u:e.vowelU,e:e.vowelE,o:e.vowelO};
+  return VOWEL_KEYS.some(k=>m[k]>0.001)?m:{a:1};
+}
+function stepVowels(e,dt){
+  const t=targetVowels(e);let tot=0;for(const k of VOWEL_KEYS)tot+=Math.max(0,t[k]||0);
+  const kS=1-Math.exp(-dt*18);
+  for(const k of VOWEL_KEYS){const v=tot>0?Math.max(0,t[k]||0)/tot:(k==='a'?1:0);vowelCur[k]+=(v-vowelCur[k])*kS;}
+  e.vw=Object.assign({},vowelCur);
+}
